# Copy to .env for local development. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=8787

LOG_LEVEL=info
LOG_PRETTY=true
# Local dev only: write raw formula bodies to logs.
LOG_FORMULA_BODIES=false

# Comma-separated allowed origins for the task pane. Empty = same-origin only.
CORS_ORIGINS=https://localhost:3000

# Hops of reverse proxy in front of this service — Azure Container Apps and
# Render both terminate TLS one hop in front of the app. 0 = trust none;
# set to 1 for a single standard ingress so rate-limiting keys on the real client IP.
TRUST_PROXY_HOPS=0

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute

# Accept POST /v1/events (anonymous, opt-in usage telemetry). Nothing is
# persisted in the MVP; events are structured-logged only. See docs/privacy-statement.md.
TELEMETRY_ENABLED=true

# cloud | local | enterprise  (MVP implements cloud)
PRIVACY_MODE=cloud

# Which vendor backs PRIVACY_MODE=cloud: claude | deepseek
AI_PROVIDER=claude
# Leave unset (or blank) for a sensible per-provider default (claude-sonnet-5 / deepseek-flash).
AI_MODEL=
ANTHROPIC_API_KEY=
# Only used when AI_PROVIDER=deepseek. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Claude only — DeepSeek always uses its own JSON mode instead.
AI_STRUCTURED_OUTPUT=true
AI_MAX_TOKENS=3000
# AI_ENDPOINT=            # for PRIVACY_MODE=enterprise (stub)
